# Copy this file to .env and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# Without these, the app still works, but "déjà vu" match memory stays
# local to each browser instead of being shared across the team.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
